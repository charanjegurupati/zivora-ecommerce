NODE_ENV=production
PORT=5000
MONGO_URI=your_mongodb_atlas_connection_string_here
FRONTEND_ORIGIN=https://zivora-ecommerce.netlify.app

JWT_ACCESS_SECRET=generate_a_long_random_secret_here
JWT_REFRESH_SECRET=generate_another_long_random_secret_here

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
