{
  "name": "zivora-server",
  "version": "1.0.0",
  "description": "Zivora Ecommerce REST API",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node src/scripts/seed.js",
    "check-users": "node src/scripts/check-users.js",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
